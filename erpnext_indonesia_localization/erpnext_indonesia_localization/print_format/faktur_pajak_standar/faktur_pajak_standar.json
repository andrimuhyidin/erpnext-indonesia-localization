 "doctype": "Print Format",
 "format_data": "[]",
 "html": "<!-- Standard Faktur Pajak Indonesia -->\n<div class=\"tax-invoice-container\" style=\"font-family: Arial, sans-serif; font-size: 12px; border: 2px solid #000; padding: 10px;\">\n    <div style=\"text-align: center; font-weight: bold; font-size: 16px; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 10px;\">\n        FAKTUR PAJAK\n    </div>\n    \n    <div style=\"margin-bottom: 15px;\">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <td style=\"width: 200px; padding: 5px; border: 1px solid #000;\">Kode & Nomor Seri Faktur Pajak</td>\n                <td style=\"padding: 5px; border: 1px solid #000;\">: {{ doc.custom_tax_invoice_number or '' }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div style=\"margin-bottom: 15px; border: 1px solid #000; padding: 5px;\">\n        <strong>Pengusaha Kena Pajak</strong>\n        <table style=\"width: 100%; margin-top: 5px;\">\n            <tr><td style=\"width: 150px;\">Nama</td><td>: {{ doc.company }}</td></tr>\n            <tr><td>Alamat</td><td>: {{ frappe.db.get_value('Address', {'is_your_company_address': 1, 'company': doc.company}, 'address_line1') or '' }}</td></tr>\n            <tr><td>NPWP</td><td>: {{ frappe.db.get_value('Company', doc.company, 'tax_id') or '' }}</td></tr>\n        </table>\n    </div>\n\n    <div style=\"margin-bottom: 15px; border: 1px solid #000; padding: 5px;\">\n        <strong>Pembeli Barang Kena Pajak / Penerima Jasa Kena Pajak</strong>\n        <table style=\"width: 100%; margin-top: 5px;\">\n            <tr><td style=\"width: 150px;\">Nama</td><td>: {{ doc.customer_name }}</td></tr>\n            <tr><td>Alamat</td><td>: {{ doc.address_display|replace('\\n', ', ') }}</td></tr>\n            <tr><td>NPWP</td><td>: {{ doc.tax_id or '' }}</td></tr>\n        </table>\n    </div>\n\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #000;\">\n        <thead>\n            <tr style=\"background: #eee;\">\n                <th style=\"border: 1px solid #000; padding: 5px; text-align: center;\">No.</th>\n                <th style=\"border: 1px solid #000; padding: 5px; text-align: center;\">Nama Barang Kena Pajak / Jasa Kena Pajak</th>\n                <th style=\"border: 1px solid #000; padding: 5px; text-align: center;\">Harga Jual/Penggantian/Uang Muka/Termin</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td style=\"border: 1px solid #000; padding: 5px; text-align: center;\">{{ loop.index }}</td>\n                <td style=\"border: 1px solid #000; padding: 5px;\">{{ item.item_name }}</td>\n                <td style=\"border: 1px solid #000; padding: 5px; text-align: right;\">{{ doc.get_formatted(\"base_amount\", item) }}</td>\n            </tr>\n            {% endfor %}\n            <tr>\n                <td colspan=\"2\" style=\"border: 1px solid #000; padding: 5px; text-align: right; font-weight: bold;\">Harga Jual/Penggantian</td>\n                <td style=\"border: 1px solid #000; padding: 5px; text-align: right;\">{{ doc.get_formatted(\"base_net_total\") }}</td>\n            </tr>\n            <tr>\n                <td colspan=\"2\" style=\"border: 1px solid #000; padding: 5px; text-align: right; font-weight: bold;\">Potongan Harga</td>\n                <td style=\"border: 1px solid #000; padding: 5px; text-align: right;\">{{ doc.get_formatted(\"base_discount_amount\") }}</td>\n            </tr>\n            <tr>\n                <td colspan=\"2\" style=\"border: 1px solid #000; padding: 5px; text-align: right; font-weight: bold;\">Dasar Pengenaan Pajak</td>\n                <td style=\"border: 1px solid #000; padding: 5px; text-align: right;\">{{ doc.get_formatted(\"base_net_total\") }}</td>\n            </tr>\n            <tr>\n                <td colspan=\"2\" style=\"border: 1px solid #000; padding: 5px; text-align: right; font-weight: bold;\">PPN = 11% x Dasar Pengenaan Pajak</td>\n                <td style=\"border: 1px solid #000; padding: 5px; text-align: right;\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\n            </tr>\n        </tbody>\n    </table>\n\n    <div style=\"margin-top: 30px; text-align: right;\">\n        {{ doc.transaction_date }}\n        <br><br><br><br>\n        ( {{ frappe.db.get_value('Company', doc.company, 'tax_representative') or doc.company }} )\n    </div>\n</div>\n\n<style>\n@media print {\n    .tax-invoice-container {\n        border: none !important;\n    }\n}\n</style>",
 "is_standard": "Yes",
